readings_1 = [12.456, 4.2, 55.8, -3.1, 24.999, 100.2, 18.0]
low_1 = 0.0
high_1 = 50.0
filteredList = []

def filter_sensor_noise(readings, low_limit, high_limit):
    
    for reading in readings:
        if (low_limit <= reading <= high_limit):
            filteredList.append(round(reading,2))
        else:
            filteredList.append("OUT_OF_BOUNDS")

filter_sensor_noise(readings_1, low_1, high_1)
print(filteredList)
